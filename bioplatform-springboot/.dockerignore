# ============================================================
# 生物信息学云平台 - Spring Boot .dockerignore
# 排除不需要的文件，优化 Docker 构建上下文
# ============================================================

# Maven 构建输出（在容器内重新构建）
target/
!.mvn/wrapper/maven-wrapper.jar

# IDE 配置文件
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath

# Git 版本控制
.git/
.gitignore

# 日志文件
*.log
logs/

# 操作系统文件
.DS_Store
Thumbs.db

# 文档
README.md
LICENSE
docs/

# Docker 相关（避免递归）
docker-compose*.yml
.dockerignore
Dockerfile
