<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bioplatform.mapper.UserRoleMapper">

    <resultMap id="BaseResultMap" type="com.bioplatform.entity.UserRole">
        <id column="user_id" property="userId"/>
        <id column="role_id" property="roleId"/>
    </resultMap>

    <sql id="Base_Column_List">
        `user_id`, `role_id`
    </sql>

    <!-- ==================== Basic CRUD ==================== -->

    <insert id="insert" useGeneratedKeys="false">
        INSERT INTO `user_roles` (`user_id`, `role_id`)
        VALUES (#{userId}, #{roleId})
    </insert>

    <!-- Batch insert: pass collection="list" -->
    <insert id="batchInsert">
        INSERT INTO `user_roles` (`user_id`, `role_id`)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.userId}, #{item.roleId})
        </foreach>
    </insert>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `user_roles`
        WHERE `user_id` = #{userId}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `user_roles`
        ORDER BY `user_id` ASC, `role_id` ASC
    </select>

    <delete id="deleteByUserId">
        DELETE FROM `user_roles` WHERE `user_id` = #{userId}
    </delete>

    <delete id="deleteByRoleId">
        DELETE FROM `user_roles` WHERE `role_id` = #{roleId}
    </delete>

    <delete id="deleteById">
        DELETE FROM `user_roles`
        WHERE `user_id` = #{userId} AND `role_id` = #{roleId}
    </delete>

</mapper>
