<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bioplatform.mapper.OperationLogMapper">

    <resultMap id="BaseResultMap" type="com.bioplatform.entity.OperationLog">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="operation" property="operation"/>
        <result column="method" property="method"/>
        <result column="params" property="params"/>
        <result column="result" property="result"/>
        <result column="ip" property="ip"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        `id`, `user_id`, `operation`, `method`, `params`,
        `result`, `ip`, `created_at`
    </sql>

    <!-- ==================== Basic CRUD ==================== -->

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `operation_logs` (`user_id`, `operation`, `method`, `params`, `result`, `ip`)
        VALUES (#{userId}, #{operation}, #{method}, #{params}, #{result}, #{ip})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `operation_logs`
        WHERE `id` = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `operation_logs`
        <where>
            <if test="userId != null">
                AND `user_id` = #{userId}
            </if>
            <if test="operation != null and operation != ''">
                AND `operation` LIKE CONCAT('%', #{operation}, '%')
            </if>
        </where>
        ORDER BY `created_at` DESC
    </select>

    <update id="updateById">
        UPDATE `operation_logs`
        <set>
            <if test="operation != null and operation != ''">`operation` = #{operation},</if>
            <if test="method != null">`method` = #{method},</if>
            <if test="params != null">`params` = #{params},</if>
            <if test="result != null">`result` = #{result},</if>
            <if test="ip != null">`ip` = #{ip},</if>
        </set>
        WHERE `id` = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `operation_logs` WHERE `id` = #{id}
    </delete>

    <!-- ==================== Filtered Query ==================== -->

    <!-- Comprehensive filter: date range, userId, operation type -->
    <select id="selectWithFilter" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `operation_logs`
        <where>
            <if test="userId != null">
                AND `user_id` = #{userId}
            </if>
            <if test="operation != null and operation != ''">
                AND `operation` LIKE CONCAT('%', #{operation}, '%')
            </if>
            <if test="method != null and method != ''">
                AND `method` = #{method}
            </if>
            <if test="startDate != null">
                AND `created_at` &gt;= #{startDate}
            </if>
            <if test="endDate != null">
                AND `created_at` &lt;= #{endDate}
            </if>
            <if test="ip != null and ip != ''">
                AND `ip` = #{ip}
            </if>
        </where>
        ORDER BY `created_at` DESC
    </select>

</mapper>
