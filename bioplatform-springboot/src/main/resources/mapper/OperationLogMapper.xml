<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bioplatform.mapper.OperationLogMapper">

    <resultMap id="BaseResultMap" type="com.bioplatform.entity.OperationLog">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="username" property="username"/>
        <result column="operation" property="operation"/>
        <result column="module" property="module"/>
        <result column="method" property="method"/>
        <result column="params" property="params"/>
        <result column="result" property="result"/>
        <result column="status" property="status"/>
        <result column="ip" property="ip"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        `id`, `user_id`, `username`, `operation`, `module`, `method`, `params`,
        `result`, `status`, `ip`, `created_at`
    </sql>

    <!-- 通用筛选条件：供 selectAll / selectWithFilter 复用 -->
    <sql id="Filter_Conditions">
        <if test="userId != null">
            AND `user_id` = #{userId}
        </if>
        <if test="username != null and username != ''">
            AND `username` LIKE CONCAT('%', #{username}, '%')
        </if>
        <if test="operation != null and operation != ''">
            AND `operation` LIKE CONCAT('%', #{operation}, '%')
        </if>
        <if test="module != null and module != ''">
            AND `module` = #{module}
        </if>
        <if test="status != null and status != ''">
            AND `status` = #{status}
        </if>
        <if test="method != null and method != ''">
            AND `method` = #{method}
        </if>
        <if test="startDate != null and startDate != ''">
            AND `created_at` &gt;= #{startDate}
        </if>
        <if test="endDate != null and endDate != ''">
            AND `created_at` &lt; DATE_ADD(#{endDate}, INTERVAL 1 DAY)
        </if>
        <if test="ip != null and ip != ''">
            AND `ip` = #{ip}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (`operation` LIKE CONCAT('%', #{keyword}, '%')
                 OR `params` LIKE CONCAT('%', #{keyword}, '%')
                 OR `method` LIKE CONCAT('%', #{keyword}, '%'))
        </if>
    </sql>

    <!-- ==================== Basic CRUD ==================== -->

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `operation_logs`
            (`user_id`, `username`, `operation`, `module`, `method`, `params`, `result`, `status`, `ip`)
        VALUES
            (#{userId}, #{username}, #{operation}, #{module}, #{method}, #{params}, #{result}, #{status}, #{ip})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `operation_logs`
        WHERE `id` = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `operation_logs`
        <where>
            <include refid="Filter_Conditions"/>
        </where>
        ORDER BY `created_at` DESC
    </select>

    <update id="updateById">
        UPDATE `operation_logs`
        <set>
            <if test="operation != null and operation != ''">`operation` = #{operation},</if>
            <if test="module != null">`module` = #{module},</if>
            <if test="method != null">`method` = #{method},</if>
            <if test="params != null">`params` = #{params},</if>
            <if test="result != null">`result` = #{result},</if>
            <if test="status != null and status != ''">`status` = #{status},</if>
            <if test="ip != null">`ip` = #{ip},</if>
        </set>
        WHERE `id` = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `operation_logs` WHERE `id` = #{id}
    </delete>

    <!-- ==================== Filtered Query ==================== -->

    <!-- 综合筛选：用户名/模块/状态/操作/关键词/日期范围/IP -->
    <select id="selectWithFilter" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `operation_logs`
        <where>
            <include refid="Filter_Conditions"/>
        </where>
        ORDER BY `created_at` DESC
    </select>

</mapper>
