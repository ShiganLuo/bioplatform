<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bioplatform.mapper.RolePermissionMapper">

    <resultMap id="BaseResultMap" type="com.bioplatform.entity.RolePermission">
        <id column="role_id" property="roleId"/>
        <id column="permission_id" property="permissionId"/>
    </resultMap>

    <sql id="Base_Column_List">
        `role_id`, `permission_id`
    </sql>

    <!-- ==================== Basic CRUD ==================== -->

    <insert id="insert" useGeneratedKeys="false">
        INSERT INTO `role_permissions` (`role_id`, `permission_id`)
        VALUES (#{roleId}, #{permissionId})
    </insert>

    <!-- Batch insert: pass collection="list" -->
    <insert id="batchInsert">
        INSERT INTO `role_permissions` (`role_id`, `permission_id`)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.roleId}, #{item.permissionId})
        </foreach>
    </insert>

    <select id="selectByRoleId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `role_permissions`
        WHERE `role_id` = #{roleId}
    </select>

    <select id="selectByPermissionId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `role_permissions`
        WHERE `permission_id` = #{permissionId}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `role_permissions`
        ORDER BY `role_id` ASC, `permission_id` ASC
    </select>

    <delete id="deleteByRoleId">
        DELETE FROM `role_permissions` WHERE `role_id` = #{roleId}
    </delete>

    <delete id="deleteByPermissionId">
        DELETE FROM `role_permissions` WHERE `permission_id` = #{permissionId}
    </delete>

    <delete id="deleteById">
        DELETE FROM `role_permissions`
        WHERE `role_id` = #{roleId} AND `permission_id` = #{permissionId}
    </delete>

</mapper>
