<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bioplatform.mapper.DataFileMapper">

    <resultMap id="BaseResultMap" type="com.bioplatform.entity.DataFile">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="path" property="path"/>
        <result column="file_type" property="fileType"/>
        <result column="file_size" property="fileSize"/>
        <result column="content_hash" property="contentHash"/>
        <result column="organism" property="organism"/>
        <result column="genome_version" property="genomeVersion"/>
        <result column="project_id" property="projectId"/>
        <result column="uploaded_by" property="uploadedBy"/>
        <result column="project_name" property="projectName"/>
        <result column="uploader_name" property="uploaderName"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        `id`, `name`, `path`, `file_type`, `file_size`, `content_hash`,
        `organism`, `genome_version`, `project_id`,
        `uploaded_by`, `created_at`
    </sql>

    <!-- ==================== Basic CRUD ==================== -->

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `data_files` (`name`, `path`, `file_type`, `file_size`, `content_hash`,
                                  `organism`, `genome_version`, `project_id`, `uploaded_by`)
        VALUES (#{name}, #{path}, #{fileType}, #{fileSize}, #{contentHash},
                #{organism}, #{genomeVersion}, #{projectId}, #{uploadedBy})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `data_files`
        WHERE `id` = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT f.`id`, f.`name`, f.`path`, f.`file_type`, f.`file_size`, f.`content_hash`,
               f.`organism`, f.`genome_version`, f.`project_id`, f.`uploaded_by`, f.`created_at`,
               p.`name` AS project_name, u.`username` AS uploader_name
        FROM `data_files` f
        LEFT JOIN `projects` p ON f.`project_id` = p.`id`
        LEFT JOIN `users` u ON f.`uploaded_by` = u.`id`
        <where>
            <if test="name != null and name != ''">
                AND f.`name` LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="fileType != null and fileType != ''">
                AND f.`file_type` = #{fileType}
            </if>
            <if test="projectId != null">
                AND f.`project_id` = #{projectId}
            </if>
            <if test="uploadedBy != null">
                AND f.`uploaded_by` = #{uploadedBy}
            </if>
            <if test="organism != null and organism != ''">
                AND f.`organism` = #{organism}
            </if>
        </where>
        ORDER BY f.`created_at` DESC
    </select>

    <update id="updateById">
        UPDATE `data_files`
        <set>
            <if test="name != null and name != ''">`name` = #{name},</if>
            <if test="path != null and path != ''">`path` = #{path},</if>
            <if test="fileType != null">`file_type` = #{fileType},</if>
            <if test="fileSize != null">`file_size` = #{fileSize},</if>
            <if test="organism != null">`organism` = #{organism},</if>
            <if test="genomeVersion != null">`genome_version` = #{genomeVersion},</if>
            <if test="projectId != null">`project_id` = #{projectId},</if>
        </set>
        WHERE `id` = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `data_files` WHERE `id` = #{id}
    </delete>

    <!-- ==================== Custom Queries ==================== -->

    <select id="selectByProjectId" resultMap="BaseResultMap">
        SELECT f.`id`, f.`name`, f.`path`, f.`file_type`, f.`file_size`, f.`content_hash`,
               f.`organism`, f.`genome_version`, f.`project_id`, f.`uploaded_by`, f.`created_at`,
               p.`name` AS project_name, u.`username` AS uploader_name
        FROM `data_files` f
        LEFT JOIN `projects` p ON f.`project_id` = p.`id`
        LEFT JOIN `users` u ON f.`uploaded_by` = u.`id`
        WHERE f.`project_id` = #{projectId}
        <if test="fileType != null and fileType != ''">
            AND f.`file_type` = #{fileType}
        </if>
        <if test="name != null and name != ''">
            AND f.`name` LIKE CONCAT('%', #{name}, '%')
        </if>
        ORDER BY f.`created_at` DESC
    </select>

    <select id="searchByName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `data_files`
        WHERE `name` LIKE CONCAT('%', #{name}, '%')
        <if test="projectId != null">
            AND `project_id` = #{projectId}
        </if>
        <if test="fileType != null and fileType != ''">
            AND `file_type` = #{fileType}
        </if>
        ORDER BY `created_at` DESC
    </select>

    <select id="selectByFileType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `data_files`
        WHERE `file_type` = #{fileType}
        <if test="projectId != null">
            AND `project_id` = #{projectId}
        </if>
        ORDER BY `created_at` DESC
    </select>

    <!-- 秒传检查：同项目下同内容文件 -->
    <select id="selectByHashAndProject" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `data_files`
        WHERE `content_hash` = #{contentHash} AND `project_id` = #{projectId}
        ORDER BY `id` DESC
        LIMIT 1
    </select>

    <select id="sumFileSizeByUser" resultType="long">
        SELECT COALESCE(SUM(`file_size`), 0)
        FROM `data_files`
        WHERE `uploaded_by` = #{userId}
    </select>

    <select id="sumTotalFileSize" resultType="long">
        SELECT COALESCE(SUM(`file_size`), 0)
        FROM `data_files`
    </select>

</mapper>
