<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bioplatform.mapper.AgentConversationMapper">

    <resultMap id="BaseResultMap" type="com.bioplatform.entity.AgentConversation">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="project_id" property="projectId"/>
        <result column="title" property="title"/>
        <result column="model_name" property="modelName"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        `id`, `user_id`, `project_id`, `title`, `model_name`,
        `created_at`, `updated_at`
    </sql>

    <!-- ==================== Basic CRUD ==================== -->

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `agent_conversations` (`user_id`, `project_id`, `title`, `model_name`)
        VALUES (#{userId}, #{projectId}, #{title}, #{modelName})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `agent_conversations`
        WHERE `id` = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `agent_conversations`
        <where>
            <if test="userId != null">
                AND `user_id` = #{userId}
            </if>
            <if test="projectId != null">
                AND `project_id` = #{projectId}
            </if>
            <if test="title != null and title != ''">
                AND `title` LIKE CONCAT('%', #{title}, '%')
            </if>
        </where>
        ORDER BY `updated_at` DESC
    </select>

    <update id="updateById">
        UPDATE `agent_conversations`
        <set>
            <if test="title != null">`title` = #{title},</if>
            <if test="modelName != null">`model_name` = #{modelName},</if>
            <if test="projectId != null">`project_id` = #{projectId},</if>
        </set>
        WHERE `id` = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `agent_conversations` WHERE `id` = #{id}
    </delete>

    <!-- ==================== Custom Queries ==================== -->

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `agent_conversations`
        WHERE `user_id` = #{userId}
        ORDER BY `updated_at` DESC
    </select>

    <select id="selectByProjectId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM `agent_conversations`
        WHERE `project_id` = #{projectId}
        ORDER BY `updated_at` DESC
    </select>

</mapper>
